<resources>

    <style name="Theme.MuseMusic.MD3" parent="@style/Theme.Material3.DynamicColors.DayNight">
        <item name="colorPrimary">@color/netease_brand</item>
        <item name="colorOnPrimary">@color/netease_on_brand</item>
        <item name="colorPrimaryContainer">@color/netease_brand_container</item>
        <item name="colorOnPrimaryContainer">@color/netease_on_brand_container</item>
        <item name="colorSecondary">@color/netease_brand</item>
        <item name="colorOnSecondary">@color/netease_on_brand</item>
        <item name="colorSurface">@color/netease_surface</item>
        <item name="colorOnSurface">@color/netease_text_primary</item>
        <item name="colorSurfaceVariant">@color/netease_surface_subtle</item>
        <item name="colorOnSurfaceVariant">@color/netease_text_secondary</item>
        <item name="android:colorBackground">@color/netease_background</item>
        <item name="colorOnBackground">@color/netease_text_primary</item>
        <item name="colorOutline">@color/netease_outline</item>
        <item name="colorOutlineVariant">@color/netease_divider</item>
        <item name="colorAccent">@color/netease_brand</item>
        <item name="android:colorAccent">@color/netease_brand</item>
        <item name="android:textColorPrimary">@color/netease_text_primary</item>
        <item name="android:textColorSecondary">@color/netease_text_secondary</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="roundSelector">@drawable/round_selector</item>
        <item name="rectSelector">@drawable/rect_selector</item>
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Elevated</item>
        <item name="materialButtonStyle">@style/MaterialButtonTheme</item>
        <item name="popupMenuBackground">@drawable/popup_background</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.MuseMusic.MD3.Black" parent="@style/Theme.MuseMusic.MD3" />

    <style name="Theme.AppWidget" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="colorSurface">@android:color/system_accent1_50</item>
    </style>

    <style name="Theme.MuseMusic.SplashScreen" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/avd_splash</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>
</resources>
